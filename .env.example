# Copy to .env; replace BOTH placeholders with independent random hex values.
# Example: openssl rand -hex 32
POSTGRES_PASSWORD=
API_KEY=
PUBLIC_VARIANTS=false
CORS_ORIGINS=
WORKER_CONCURRENCY=1
VIPS_CONCURRENCY=1
MAX_UPLOAD_BYTES=20971520
MAX_PIXELS=40000000
MAX_DIMENSION=20000
MAX_OUTPUT_COUNT=16
MAX_OUTPUT_BYTES=104857600
PROCESS_TIMEOUT=120s
# Empty uses the built-in web profile; nonempty must match the application schema.
PROFILES_JSON=
# Standalone (outside Compose) also requires:
# DATABASE_URL=postgres://bytedown@localhost:5432/bytedown?sslmode=verify-full
# STORAGE_DIR=/data
# LISTEN_ADDR=:8080
